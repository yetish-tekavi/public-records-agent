<mxfile host="app.diagrams.net"><diagram id="final-architecture" name="Final architecture"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Final architecture (as implemented)" style="text;html=0;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1B2631;" vertex="1" parent="1"><mxGeometry x="25" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Four deterministic agents on one LangGraph workflow; ToT is a conditional subgraph, not a fifth agent; a human authorizes every output" style="text;html=0;fontSize=12;align=left;verticalAlign=middle;fontColor=#5F6B73;" vertex="1" parent="1"><mxGeometry x="25" y="60" width="1200" height="30" as="geometry"/></mxCell><mxCell id="wf" value="LangGraph StateGraph workflow (app/workflows/graph.py)" style="rounded=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;whiteSpace=wrap;html=0;fillColor=#F1F3F5;strokeColor=#ADB5BD;fontColor=#1B2631;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="200" y="110" width="820" height="420" as="geometry"/></mxCell><mxCell id="tot" value="Conditional ToT subgraph&#xa;only for AMBIGUOUS / CONFLICTING&#xa;branching 3 · depth 3 · beam 2 · min 70" style="rounded=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;whiteSpace=wrap;html=0;fillColor=#E6F4F1;strokeColor=#2A9D8F;fontColor=#1B2631;fontSize=10;fontFamily=Calibri;dashed=1;" vertex="1" parent="1"><mxGeometry x="810" y="230" width="195" height="195" as="geometry"/></mxCell><mxCell id="mcp" value="MCP tool layer: official MCP Python SDK, stdio server (app/mcp_server.py), 4 read-only tools" style="rounded=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;whiteSpace=wrap;html=0;fillColor=#EEE8F6;strokeColor=#9C89C9;fontColor=#1B2631;fontSize=11;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="200" y="550" width="820" height="85" as="geometry"/></mxCell><mxCell id="future" value="Future architecture (not implemented)&#xa;LLM planner and critic in the workflow&#xa;Audio / video transcription and redaction&#xa;Multi-user access control&#xa;Persistent cross-process checkpoints" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#FAFAFA;strokeColor=#8A939B;fontColor=#5F6B73;fontSize=10;fontFamily=Calibri;dashed=1;" vertex="1" parent="1"><mxGeometry x="25" y="550" width="155" height="175" as="geometry"/></mxCell><mxCell id="in" value="Synthetic inputs&#xa;OPRA-style request + synthetic record&#xa;(data/, 'Synthetic: yes' header)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#FFF4D6;strokeColor=#D9A400;fontColor=#1B2631;fontSize=11;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="25" y="145" width="155" height="165" as="geometry"/></mxCell><mxCell id="legend" value="Legend&#xa;→ workflow control&#xa;⇢ tool call / feedback&#xa;dashed box: conditional&#xa;grey box: future" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CED4DA;fontColor=#5F6B73;fontSize=10;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="25" y="345" width="155" height="130" as="geometry"/></mxCell><mxCell id="orch" value="Orchestrator Agent: plans, routes, merges evidence, bounded retries, step limit, escalation" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#14273E;strokeColor=#14273E;fontColor=#FFFFFF;fontSize=12;fontFamily=Calibri;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="145" width="780" height="55" as="geometry"/></mxCell><mxCell id="ra" value="Record Analysis Agent&#xa;detect_pii · ≤ 2 attempts" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontSize=11;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="220" y="230" width="175" height="80" as="geometry"/></mxCell><mxCell id="pr" value="Policy Research Agent&#xa;search_policy · ≤ 2 queries per category" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontSize=11;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="415" y="230" width="175" height="80" as="geometry"/></mxCell><mxCell id="qa" value="Compliance &amp; QA Agent&#xa;propose_redactions · validate_citations · missed-PII sweep" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontSize=11;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="610" y="230" width="175" height="80" as="geometry"/></mxCell><mxCell id="dec" value="Evidence&#xa;decision" style="rhombus;whiteSpace=wrap;html=0;fillColor=#F2B134;strokeColor=#F2B134;fontColor=#1B2631;fontSize=11;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="610" y="335" width="175" height="95" as="geometry"/></mxCell><mxCell id="tr" value="MISSING → one targeted retrieval, then re-check" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#DCE6F0;strokeColor=#8FA9C4;fontColor=#1B2631;fontSize=11;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="415" y="350" width="175" height="60" as="geometry"/></mxCell><mxCell id="gen" value="generate" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#2A9D8F;strokeColor=#2A9D8F;fontColor=#FFFFFF;fontSize=11;fontFamily=Calibri;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="818" y="300" width="85" height="50" as="geometry"/></mxCell><mxCell id="eva" value="evaluate&#xa;QA critic" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#2A9D8F;strokeColor=#2A9D8F;fontColor=#FFFFFF;fontSize=10;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="912" y="300" width="85" height="50" as="geometry"/></mxCell><mxCell id="pru" value="prune&#xa;reject · beam" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#2A9