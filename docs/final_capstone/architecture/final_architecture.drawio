th="190" height="38" as="geometry"/></mxCell><mxCell id="t_pii" value="detect_pii" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#6C5BA7;strokeColor=#6C5BA7;fontColor=#FFFFFF;fontSize=11;fontFamily=Calibri;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="615" y="585" width="190" height="38" as="geometry"/></mxCell><mxCell id="t_prop" value="propose_redactions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#6C5BA7;strokeColor=#6C5BA7;fontColor=#FFFFFF;fontSize=11;fontFamily=Calibri;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="815" y="585" width="190" height="38" as="geometry"/></mxCell><mxCell id="rag" value="Policy RAG knowledge base&#xa;Hybrid BM25 + ChromaDB (all-MiniLM-L6-v2) · 5 official nj.gov documents · 496 chunks · provenance guard" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#E9EEF4;strokeColor=#8FA9C4;fontColor=#1B2631;fontSize=11;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="200" y="655" width="405" height="75" as="geometry"/></mxCell><mxCell id="pii" value="Presidio + spaCy&#xa;PII detector" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#E9EEF4;strokeColor=#8FA9C4;fontColor=#1B2631;fontSize=11;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="615" y="655" width="190" height="75" as="geometry"/></mxCell><mxCell id="rules" value="Deterministic redaction rules" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#E9EEF4;strokeColor=#8FA9C4;fontColor=#1B2631;fontSize=11;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="815" y="655" width="205" height="75" as="geometry"/></mxCell><mxCell id="reeval" value="Reviewer-requested re-evaluation&#xa;≤ 2 per finding: Policy Research, QA and ToT run again" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#DCE6F0;strokeColor=#8FA9C4;fontColor=#1B2631;fontSize=11;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="1045" y="130" width="260" height="95" as="geometry"/></mxCell><mxCell id="hr" value="Human review (mandatory)&#xa;LangGraph interrupt() → Streamlit review session&#xa;approve · reject · modify · re-evaluate · add missed redaction" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#2D6A4F;strokeColor=#2D6A4F;fontColor=#FFFFFF;fontSize=11;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="1045" y="255" width="260" height="150" as="geometry"/></mxCell><mxCell id="auth" value="Final authorization&#xa;named reviewer · every finding resolved" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#D8F3DC;strokeColor=#74C69D;fontColor=#1B2631;fontSize=11;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="1045" y="430" width="260" height="65" as="geometry"/></mxCell><mxCell id="red" value="Deterministic span redaction&#xa;derivative in outputs/ · original unchanged" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#D8F3DC;strokeColor=#74C69D;fontColor=#1B2631;fontSize=11;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="1045" y="520" width="260" height="65" as="geometry"/></mxCell><mxCell id="aud" value="Audit report&#xa;hash-chained review events · tool calls · ToT branches" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#D8F3DC;strokeColor=#74C69D;fontColor=#1B2631;fontSize=11;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="1045" y="610" width="260" height="75" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;" edge="1" parent="1" source="in" target="orch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;" edge="1" parent="1" source="orch" target="ra"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;" edge="1" pare